PORT=3000
NODE_ENV=development
# Keep SQLite data and authorized uploads on durable storage in production.
DATABASE_PATH=
MOVIE_UPLOAD_DIR=
POSTER_UPLOAD_DIR=
MERLIN_UPLOAD_DIR=
MERLIN_MOVIE_UPLOAD_DIR=
SOCIAL_UPLOAD_DIR=
# Use a temporary, non-persistent directory for recognition samples in production.
SAMPLE_UPLOAD_DIR=
# Only set to "loopback" when a local reverse proxy (such as Caddy) fronts the app.
TRUST_PROXY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=
CAPACITOR_APP_ORIGINS=https://localhost
MAX_UPLOAD_BYTES=32212254720
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FPCALC_PATH=fpcalc
# Optional Google Gemini settings for Mohammad AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional OpenAI settings for Mohammad AI (fallback).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional local Ollama settings for Mohammad AI (no paid provider fallback).
MOHAMMAD_AI_BASE_URL=http://127.0.0.1:11434
MOHAMMAD_AI_MODEL=
