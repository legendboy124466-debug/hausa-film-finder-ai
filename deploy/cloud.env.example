# Copy to deploy/cloud.env on the cloud host. Keep that file private and out of Git.
# Set strong, unique values through the host's private environment/secrets manager.
HF_ADMIN_USERNAME_SECRET=
HF_ADMIN_PASSWORD_SECRET=
HF_SESSION_SECRET=
PUBLIC_HOST=films.example.org
# Linux mount points for provider-managed, persistent block volumes.
HF_DATABASE_HOST_PATH=/mnt/hausa-film-finder/database
HF_MEDIA_HOST_PATH=/mnt/hausa-film-finder/media
HF_CADDY_DATA_HOST_PATH=/mnt/hausa-film-finder/caddy-data
HF_CADDY_CONFIG_HOST_PATH=/mnt/hausa-film-finder/caddy-config
# Optional private Ollama endpoint/model. Public URLs are rejected by the AI service.
MOHAMMAD_AI_BASE_URL=http://127.0.0.1:11434
MOHAMMAD_AI_MODEL=
