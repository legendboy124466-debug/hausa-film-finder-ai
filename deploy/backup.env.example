HF_COMPOSE_ENV_FILE=/etc/hausa-film-finder/cloud.env
HF_DATABASE_HOST_PATH=/srv/hausa-film-finder/database
HF_MEDIA_HOST_PATH=/srv/hausa-film-finder/media
HF_BACKUP_DESTINATION=/mnt/hausa-film-finder-backups
HF_SQLITE3_PATH=/usr/bin/sqlite3
